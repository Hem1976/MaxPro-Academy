# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Links/images in Postmark emails (use production URL when developing locally)
NEXT_PUBLIC_EMAIL_APP_URL=https://maxpro-academy.vercel.app

# Supabase Management API (one-time provision: npm run supabase:provision)
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_ORG_SLUG=optional-if-multiple-orgs
# SUPABASE_DB_PASSWORD=optional-min-8-chars

# Supabase (when set, app uses real Auth/DB instead of demo mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Postgres URI for one-time migrations (Dashboard → Database → Connection string)
# Prefer plain password (avoids @ / special-char URI mistakes):
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_DB_REGION=eu-central-1
# Or URI (encode @ as %40): SUPABASE_DB_URL=postgresql://postgres.[ref]:pass%40word@aws-0-[region].pooler.supabase.com:5432/postgres

# Video provider (external | youtube | vimeo | mux | cloudflare | placeholder)
VIDEO_PROVIDER=placeholder
VIDEO_PROVIDER_API_KEY=

# Certificates
CERTIFICATE_SIGNING_SECRET=change-me-to-a-long-random-secret

# Video transcription (optional — can also set in Admin → Settings)
# TRANSCRIPTION_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Local AI (Ollama)
# Install: https://ollama.com  then: ollama pull llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=180000

# Support
NEXT_PUBLIC_SUPPORT_EMAIL=helpdesk@maxproinfotech.com
NEXT_PUBLIC_SUPPORT_URL=https://maxproinfotech.com/contact

# Email (Postmark)
POSTMARK_API_KEY=your-postmark-server-token
POSTMARK_SENDER_EMAIL=sales@your-verified-domain.com
POSTMARK_SENDER_NAME=MaxPro Infotech
POSTMARK_MESSAGE_STREAM=outbound

# Bootstrap super admin (scripts/bootstrap-supabase-admin.ts — never commit real passwords)
# ADMIN_EMAIL=admin@maxproinfotech.com
# ADMIN_PASSWORD=